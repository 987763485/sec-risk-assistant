root = true

# ------------------------------------------------------------ 全局
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ------------------------------------------------------------ Go（官方强制 Tab）
[*.go]
indent_style = tab

# ------------------------------------------------------------ Makefile（必须是 Tab）
[Makefile]
indent_style = tab

# ------------------------------------------------------------ Markdown
# 行尾双空格是 Markdown 的换行语法，不能裁掉
[*.md]
trim_trailing_whitespace = false

# ------------------------------------------------------------ 后端
[*.{csproj,json,yml,yaml}]
indent_size = 2
[*.{cs}]
indent_size = 4
